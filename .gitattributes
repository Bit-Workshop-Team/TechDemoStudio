# 统一按 LF 入库，避免 Windows 开发机与 CI 之间的行尾抖动
* text=auto eol=lf

# 明确按二进制处理（不做行尾转换、不参与 diff）
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.exe binary
*.dll binary
*.node binary
*.zip binary
*.7z binary
*.asar binary

# Windows 脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 锁定文件的 diff 更有意义
package-lock.json -diff linguist-generated=true

# GitHub 语言统计
*.js text
src/**/*.js text
styles.css linguist-language=CSS
